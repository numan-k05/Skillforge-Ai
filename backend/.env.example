NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://skillforge:LOCAL_PASSWORD@localhost:5432/skillforge
# Keep this small for serverless deployments. Use a pooled provider URL in production.
DB_POOL_MAX=5
# Required: generate a unique secret with the command in PHASE_1_REPORT.md.
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Production requires explicit HTTPS origins with no trailing slash.
# Public frontend origin used in certificate verification QR codes.
PUBLIC_APP_URL=http://localhost:5173
# Automated tests only. Interactive sandbox checkout is disabled outside NODE_ENV=test.
SANDBOX_PAYMENT_WEBHOOK_SECRET=
# Base64-encoded 32-byte key used only to encrypt payout destinations at rest.
WALLET_ENCRYPTION_KEY=
# Leave 0 for direct connections. Set to the exact trusted proxy count when deployed.
TRUST_PROXY_HOPS=0
# General API requests allowed per IP in 15 minutes. Login and sensitive actions use tighter limits.
API_RATE_LIMIT_MAX=1200
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional server-side AI. Keep disabled until a provider key and billing are ready.
# Assessment questions fall back to the reviewed question bank when disabled or unavailable.
AI_API_KEY=
AI_API_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-4-6
AI_ENABLED=false
AI_ASSESSMENTS_ENABLED=false
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1800

# Password reset email requires a working SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Only this existing account, with database role admin, can access administration.
OWNER_ADMIN_EMAIL=
