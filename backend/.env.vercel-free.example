# Vercel Hobby + Neon Free configuration for a personal, non-commercial MVP.
# Copy these names into the Vercel backend project's Environment Variables.
# Never commit real values or rename this file to .env in Git.

NODE_ENV=production

# Use Neon's pooled connection URL for the deployed Vercel Function.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DB_POOL_MAX=3
DB_SSL_REJECT_UNAUTHORIZED=true

# Generate private values with the commands in docs/FREE_TIER_DEPLOYMENT.md.
JWT_SECRET=GENERATE_A_UNIQUE_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
WALLET_ENCRYPTION_KEY=GENERATE_A_BASE64_ENCODED_32_BYTE_KEY

# Replace these after Vercel assigns the frontend URL. Do not add a trailing slash.
CORS_ORIGIN=https://YOUR-FRONTEND.vercel.app
PUBLIC_APP_URL=https://YOUR-FRONTEND.vercel.app
OWNER_ADMIN_EMAIL=YOUR_EMAIL_ADDRESS
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_MAX=1200

# Free MVP mode: use deterministic roadmaps and the reviewed question bank.
AI_ENABLED=false
AI_ASSESSMENTS_ENABLED=false
AI_API_KEY=
AI_API_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-4-6
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1800

# Optional Resend SMTP. Password reset email will not deliver until configured.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=YOUR_RESEND_API_KEY
MAIL_FROM=SkillForge <noreply@YOUR_VERIFIED_DOMAIN>

# Sandbox checkout is intentionally unavailable in production.
SANDBOX_PAYMENT_WEBHOOK_SECRET=
